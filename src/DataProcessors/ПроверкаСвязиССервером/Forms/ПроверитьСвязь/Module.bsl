
&НаСервере
Процедура ПроверкаСвязиНаСервере()
	
	Сервер = "192.168.0.17"; 
	ИмяБазы = "CentralBase";
	Пользователь = "admin";
	Пароль = "";
	Таймаут = 5;
	ЗащищенноеСоединение = Неопределено;
	
	HTTPСоединение = Новый HTTPСоединение(Сервер, , Пользователь, Пароль, ,Таймаут, ЗащищенноеСоединение);
	
	АдресРесурса = "/" + ИмяБазы + "/hs/mobile/ping"; 
	HTTPЗапрос = Новый HTTPЗапрос(АдресРесурса);
	
	Попытка
		HTTPОтвет = HTTPСоединение.Получить(HTTPЗапрос);
	Исключение
		Сообщить("Ошибка: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	
	Если HTTPОтвет.КодСостояния = 200 Тогда
		Сообщить("Соединение установлено");
	Иначе
		Сообщить("Ошибка: " + HTTPОтвет.КодСостояния);
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверкаСвязи(Команда)
	ПроверкаСвязиНаСервере();
КонецПроцедуры
